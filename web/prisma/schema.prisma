// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Auth models (User, Session, Account, Verification) come from `bunx auth@latest generate`.
// That command overwrites this file: re-add the app models below if you rerun it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  homes         Home[]
  memories      MemoryEvent[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------- app models

enum HomeStatus {
  DRAFT // inputs captured, extraction not yet confirmed by the user
  CONFIRMED // user has checked the extracted record
}

enum InputKind {
  PHOTO
  TEXT
  PLAN
  VOICE
  POSTCODE
}

enum ExtractionStatus {
  PENDING
  DONE
  FAILED
}

/// A home the user is analysing. `record` is the confirmed, typed property record
/// that the engine reads; it only changes when the user confirms or edits it.
model Home {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname    String        @default("My home")
  status      HomeStatus    @default(DRAFT)
  postcode    String?
  /// Optional link to a row in data/out/properties.parquet (e.g. "P1a2b3c4d5e").
  propertyId  String?
  record      Json?
  /// Free-text address the user typed (their own data; never looked up from EPC).
  address     String?
  /// Selected OSM building: { osmId, polygon: [lon,lat][], widthM, depthM, bearingDeg, sharedWalls, levels? }.
  footprint   Json?
  /// Public share link (/t/[shareSlug]); null when not shared.
  shareSlug   String?       @unique
  sharedAt    DateTime?
  /// Upload id of the canvas snapshot used as the share preview image.
  shareImage  String?
  /// Last engine result for this home and the key it was computed for (record + place + model version).
  twin        Json?
  twinKey     String?
  /// Customer memory: completed / declined measures, constraints, budget, priority and a change log (see src/lib/memory.ts).
  memory      Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  inputs      HomeInput[]
  extractions Extraction[]
  scenarios   Scenario[]
  chats       Chat[]
  memories    MemoryEvent[]

  @@index([userId])
}

/// Anything the user gives us about the home: a photo, a description, a floor plan, a voice note.
model HomeInput {
  id        String    @id @default(cuid())
  homeId    String
  home      Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  kind      InputKind
  text      String?
  fileUrl   String?
  mimeType  String?
  createdAt DateTime  @default(now())

  @@index([homeId])
}

/// One run of the decision models over the inputs. `fields` maps a record field to
/// { value, confidence, source, evidence } so the review screen can show why.
model Extraction {
  id        String           @id @default(cuid())
  homeId    String
  home      Home             @relation(fields: [homeId], references: [id], onDelete: Cascade)
  status    ExtractionStatus @default(PENDING)
  models    String[]
  fields    Json?
  conflicts Json?
  error     String?
  createdAt DateTime         @default(now())

  @@index([homeId])
}

/// A what-if: a typed retrofit spec plus the engine output it produced (never LLM numbers).
model Scenario {
  id        String   @id @default(cuid())
  homeId    String
  home      Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  name      String
  spec      Json
  result    Json?
  createdAt DateTime @default(now())

  @@index([homeId])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

/// An Ask conversation about one home. Each turn is a user message and the assistant's reply.
model Chat {
  id        String        @id @default(cuid())
  homeId    String
  home      Home          @relation(fields: [homeId], references: [id], onDelete: Cascade)
  /// The first question, shortened; shown in the chat list.
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([homeId, updatedAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  /// The full Ask reply on assistant messages (scenario, trace, memory suggestion); the next question builds on its scenario.
  reply     Json?
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

enum MemoryKind {
  CONSTRAINT // e.g. listed building, renting, budget cap
  PREFERENCE // e.g. no heat pump, low disruption
  COMPLETED_RETROFIT
  RESPONSE // accepted / declined a recommendation
}

/// Customer memory (optional extension in the brief). Parsed into typed payloads.
model MemoryEvent {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeId    String?
  home      Home?      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  kind      MemoryKind
  text      String
  payload   Json
  createdAt DateTime   @default(now())

  @@index([userId])
}

/// UK postcode geography (ONS Postcode Directory via postcodes.io, OGL). Loaded by scripts/import-postcodes.ts.
model Postcode {
  /// Normalised: upper case, single space before the inward code ("B1 1BA").
  postcode   String  @id
  lat        Float
  lon        Float
  outcode    String
  district   String?
  region     String?
  country    String
  terminated Boolean @default(false)

  @@index([outcode])
}

/// OSM building footprints near a postcode, fetched from Overpass on demand (ODbL, attribute OSM contributors).
model BuildingCache {
  postcode  String   @id
  buildings Json
  fetchedAt DateTime @default(now())
}
