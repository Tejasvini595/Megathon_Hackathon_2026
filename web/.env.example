# Copy to .env. Matches compose.yaml.
DATABASE_URL="postgresql://ght:ght@localhost:5432/ght?schema=public"
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# LLMs (all through OpenRouter). Without a key, Ask and the description reader fall back to the engine's
# template explanation and the keyword rules.
OPENROUTER_API_KEY=""
# Optional: a proxy in front of OpenRouter (must end in /v1 for the Decisions API to be found).
OPENROUTER_BASE_URL=""
# Model and thinking level per job: any OpenRouter model id; reasoning none|minimal|low|medium|high|xhigh|default.
# Optional provider routing per job: LLM_<JOB>_PROVIDER="deepinfra,fireworks" (tried in order) and
# LLM_<JOB>_PROVIDER_FALLBACKS="false" to stop OpenRouter using other providers. Same for DECISION_PROVIDER.
LLM_PARSE_MODEL="deepseek/deepseek-v4.1-flash"     # Ask: question -> scenario
LLM_PARSE_REASONING="none"
LLM_EXPLAIN_MODEL="z-ai/glm-5.3-flash"             # Ask: explains the engine's results ([[slots]] only, checked by the engine)
LLM_EXPLAIN_REASONING="low"
LLM_EXTRACT_MODEL="deepseek/deepseek-v4.1-flash"   # description -> record fields
LLM_EXTRACT_REASONING="none"
LLM_VISION_MODEL="z-ai/glm-5.3-flash"              # reading energy bills (needs image input)
LLM_VISION_REASONING="low"
# Typed decisions with probabilities (OpenRouter Decisions API).
DECISION_MODEL="typesafe/jev-1.13"
DECISION_PROVIDER=""

# The Python engine (model/api.py). Without it the app shows clearly labelled example data.
ENGINE_URL="http://localhost:8000"
